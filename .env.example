# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FORMSPREE_ID: Get this from your Formspree dashboard (form ID)
# Used to send form submissions to contact@mit2fit.com
VITE_FORMSPREE_ID="xnjwjkld"

# Calendly: full event URLs (https://calendly.com/your-handle/event-type)
# These are public booking/payment URLs. No Calendly password or private API token is needed.
VITE_CALENDLY_URL="https://calendly.com/mit2health"

# Meeting schedule links
VITE_CALENDLY_CONSULT_URL="https://calendly.com/mit2health/30min"
VITE_CALENDLY_GROUP_CONSULT_URL="https://calendly.com/mit2health/group-consult-request"
VITE_CALENDLY_STANDARD_SESSION_URL="https://calendly.com/mit2health/standard-session"
VITE_CALENDLY_TRAINING_URL="https://calendly.com/mit2health/standard-session"

# Package payment links
VITE_CALENDLY_STANDARD_AUDIT_PAYMENT_URL="https://calendly.com/mit2health/payments/af21bacd-84f3-44fb-9b46-10d7aecb2745"
VITE_CALENDLY_PERFORMANCE_BUILD_PACKAGE_URL="https://calendly.com/mit2health/packages/246bf2ec-a421-432e-b516-b49039b4c218"
VITE_CALENDLY_ELITE_PROTOCOL_PACKAGE_URL="https://calendly.com/mit2health/packages/0985ffb1-2cb0-452c-9385-add879f03266"

# Optional overrides if you later create separate virtual/in-person event links.
VITE_CALENDLY_CONSULT_VIRTUAL=""
VITE_CALENDLY_CONSULT_INPERSON=""
VITE_CALENDLY_TRAINING_VIRTUAL=""
VITE_CALENDLY_TRAINING_INPERSON=""
VITE_CALENDLY_STANDARD_SESSION_VIRTUAL=""
VITE_CALENDLY_STANDARD_SESSION_INPERSON=""
